<?xml version="1.0" encoding="utf-8"?>
<!--
  Build "play" (Google Play): a loja atualiza o app, então sai tudo da autoatualização por APK
  (permissão de instalar pacotes, consulta ao instalador, receiver e FileProvider dos downloads).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />

    <queries tools:node="remove" />

    <!--
      targetSdk 36 (Android 16): voltar continua pelo KEYCODE_BACK (telas de TV tratam a tecla direto;
      sem "voltar preditivo"); em telas grandes mantém o paisagem fixo (opt-out temporário do Android 16).
    -->
    <application android:enableOnBackInvokedCallback="false">
        <property android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY" android:value="true" />
        <receiver android:name=".data.InstallStatusReceiver" tools:node="remove" />
        <provider android:name="androidx.core.content.FileProvider" tools:node="remove" />
    </application>
</manifest>
