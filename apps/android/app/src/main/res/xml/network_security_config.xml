<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Aparelhos Android antigos (TV Box / Android 7.0 e ROMs sem atualização) não têm as raízes
      atuais do Let's Encrypt (ISRG Root X1/X2/YE) e dão "Trust anchor for certification path not found".
      Confiamos nas CAs do sistema + essas raízes oficiais embutidas no app.
      Cleartext segue liberado: muitas listas IPTV são http:// (igual ao usesCleartextTraffic anterior).
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
            <certificates src="@raw/isrg_root_ye" />
        </trust-anchors>
    </base-config>
</network-security-config>
